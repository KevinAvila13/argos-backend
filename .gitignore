# =============================================
# Argos Backend - Git Ignore File
# =============================================

# Environment variables (NEVER commit credentials!)
.env
.env.local
.env.production
.env.development

# Dependencies
node_modules/
package-lock.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Build output
dist/
build/

# Temporary files
*.tmp
temp/
tmp/

# Database dumps (if you create any)
*.sql.backup
*.dump

# Claude Code project files (optional)
.claude/
